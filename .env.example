# --- Aruba Instant On (クラウドポータル) ---
# Both vars must be set to enable this source. Leave blank to disable.
ARUBA_USERNAME=you@example.com
ARUBA_PASSWORD=your-password

# --- Aruba IAP (ローカルSSH) ---
# Requires `expect(1)` in PATH. Leave IAP_HOST blank to disable this source.
IAP_HOST=192.168.0.80
# Default is 22 (SSH). Set to 4343 if you ever switch to the swarm.cgi web UI.
IAP_PORT=22
IAP_USERNAME=admin
IAP_PASSWORD=your-iap-password

# --- 動作設定 ---
NOC_LISTEN=:8080
NOC_STORE_PATH=registrations.json
NOC_AP_POSITIONS_PATH=ap-positions.json
NOC_POLL_INTERVAL=30s

# When set, the floorplan image is loaded from this directory instead of the
# embedded web/static. Useful for Docker so you can swap the venue map by
# editing a mounted volume rather than rebuilding the image.
# NOC_FLOORPLAN_DIR=/data

# Set this to require an admin token for editing AP positions.
# When set, only http://host:8080/?admin=<this-value> can drag/save APs.
# Leave empty to allow edits without auth (LAN-trust mode).
NOC_ADMIN_TOKEN=
